" width="245" height="95" as="geometry"/></mxCell><mxCell id="sw2" value="spark-worker 2&lt;br&gt;1 core · 768 MB&lt;br&gt;(ejecuta tareas)" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181D;fillColor=#FBE3D0;strokeColor=#C4621A;strokeWidth=2;rounded=1;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1585" y="845" width="245" height="95" as="geometry"/></mxCell><mxCell id="reg" value="registro (registry:2)&lt;br&gt;imágenes para los 2 nodos&lt;br&gt;127.0.0.1:5000" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181D;fillColor=#EEEEEE;strokeColor=#6A6A6A;strokeWidth=2;rounded=1;arcSize=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="215" height="80" as="geometry"/></mxCell><mxCell id="ha" value="" style="whiteSpace=wrap;html=1;fontSize=15;fontColor=#16181D;fillColor=#FFF1F0;strokeColor=#C0392B;strokeWidth=2;rounded=1;arcSize=6;dashed=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="300" y="850" width="970" height="110" as="geometry"/></mxCell><mxCell id="ha_t" value="ALTA DISPONIBILIDAD · ESCALABILIDAD · TOLERANCIA A FALLOS" style="whiteSpace=wrap;html=1;fontSize=14;fontColor=#16181D;fillColor=none;strokeColor=none;align=left;spacingLeft=8;verticalAlign=middle;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="312" y="855" width="940" height="26" as="geometry"/></mxCell><mxCell id="ha_d" value="• 2 réplicas de cada servicio, repartidas entre los 2 nodos (docker service scale para más)&lt;br&gt;• healthcheck /salud: Swarm reemplaza lo no sano · restart_policy any · rolling update start-first (sin caída)&lt;br&gt;• si cae un nodo, las réplicas se reprograman en el otro · routing mesh: :80 responde en cualquier IP&lt;br&gt;• Limitación: PostgreSQL y el manager son únicos (se mitiga con volumen y se documenta)" style="whiteSpace=wrap;html=1;fontSize=13;fontColor=#16181D;fillColor=none;strokeColor=none;align=left;spacingLeft=8;verticalAlign=top;" ver