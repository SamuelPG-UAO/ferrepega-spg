# =========================================================
# Ferrepega - Proxy de entrada (API Gateway + entrada al front)
# Nginx con nuestra configuración y los archivos estáticos del front.
# Contexto de construcción: la RAÍZ del proyecto.
# =========================================================
FROM nginx:1.27-alpine

COPY docker/nginx/edge.conf /etc/nginx/conf.d/default.conf
COPY frontend/app/static /usr/share/ferrepega/static

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/api/salud || exit 1
