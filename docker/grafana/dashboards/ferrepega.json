    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(ferrepega_ventas_registradas_total[1h])) or vector(0)",
     "legendFormat": "",
