    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "(sum(rate(http_requests_total{status=\"5xx\"}[1m])) or vector(0)) + (sum(rate(flask_http_request_total{status=~\"5..\"}[1m])) or vector(0))",
     "legendFormat": "",
     "refId": "A",
     "editorMode": "code",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "thresholds": {
