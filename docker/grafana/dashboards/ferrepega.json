  {
   "id": 5,
   "type": "timeseries",
   "title": "Réplicas vivas por servicio",
   "description": "Alta disponibilidad: si se cae un contenedor o un nodo, baja y Swarm lo vuelve a levantar.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (job) (up{job=~\"servicio-.*|front\"})",
     "legendFormat": "{{job}}",
     "refId": "A",
     "editorMode": "code",
     "range": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "lineInterpolation": "stepAfter",
      "spanNulls": false
     },
     "min": 0
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom",
     "showLegend": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Peticiones por segundo por servicio",
   "description": "",
