                  "const r = pm.response.json();",
                  "pm.test(\"El rol es vendedor\", () => pm.expect(r.usuario.rol).to.eql(\"vendedor\"));",
                  "pm.collectionVariables.set(\"token_vendedor\", r.access_token);"
