{
  "info": {
    "name": "Ferrepega - servicio-autenticacion",
    "description": "Pruebas del microservicio de autenticación (RF1). Ejecutar con 'Run collection': los requests dependen unos de otros (tokens e ids se guardan en variables de la colección).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Salud y login",
      "item": [
        {
          "name": "1.1 Salud del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El servicio reporta estado ok\", () => pm.expect(pm.response.json().estado).to.eql(\"ok\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/salud",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "salud"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1.2 Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de respuesta 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve un token JWT (3 partes)\", () => pm.expect(r.access_token.split(\".\")).to.have.lengthOf(3));",
                  "pm.test(\"El rol es admin\", () => pm.expect(r.usuario.rol).to.eql(\"admin\"));",
                  "pm.test(\"Indica cuántos segundos dura el token\", () => pm.expect(r.expires_in).to.be.above(0));",
                  "pm.test(\"No expone el hash de la contraseña\", () => pm.expect(pm.response.text()).to.not.include(\"contrasena_hash\"));",
                  "pm.collectionVariables.set(\"token_admin\", r.access_token);",
                  "pm.collectionVariables.set(\"id_admin\", r.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@ferrepega.com\",\n  \"contrasena\": \"{{admin_clave}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "1.3 Login vendedor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
