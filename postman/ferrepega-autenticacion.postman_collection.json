                  "pm.test(\"Código de respuesta 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje genérico\", () => pm.expect(pm.response.json().detail).to.eql(\"Correo o contraseña incorrectos\"));",
                  "pm.test(\"No entrega token\", () => pm.expect(pm.response.text()).to.not.include(\"access_token\"));"
                ]
