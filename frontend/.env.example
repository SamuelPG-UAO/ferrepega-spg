# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Dirección del API Gateway (el back). Se llama desde el servidor Flask, no desde el navegador.
FERREPEGA_API_URL=http://192.168.56.10

# Clave que firma la cookie de sesión del front. Debe ser larga y secreta:
# genera una con:  python3 -c "import secrets; print(secrets.token_hex(32))"
FERREPEGA_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-antes-de-la-entrega

# 1 = muestra en el login las cuentas de demostración (apágalo si no las quieres a la vista)
FERREPEGA_DEMO=1

# 1 solo cuando el sitio se sirva por HTTPS (la cookie viajará únicamente cifrada)
FERREPEGA_COOKIE_SEGURA=0
