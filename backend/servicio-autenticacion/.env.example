# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Conexión a la base de datos de este microservicio
DATABASE_URL=postgresql+psycopg2://auth_user:Ferre_auth_2025@localhost:5432/auth_db

# Clave con la que se firman los tokens JWT.
# IMPORTANTE: todos los microservicios deben usar EXACTAMENTE la misma clave,
# porque cada uno verifica los tokens por su cuenta.
# Para generar una nueva:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=ferrepega-clave-de-desarrollo-cambiar-antes-del-despliegue-0123456789
JWT_ALGORITHM=HS256

# Minutos que dura un token antes de que haya que iniciar sesión otra vez
JWT_EXPIRE_MINUTES=60
