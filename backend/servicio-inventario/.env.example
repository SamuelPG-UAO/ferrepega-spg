# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Conexión a la base de datos de este microservicio
DATABASE_URL=postgresql+psycopg2://inventario_user:Ferre_inventario_2025@localhost:5432/inventario_db

# Debe ser EXACTAMENTE la misma clave que usa servicio-autenticacion:
# este servicio no consulta a autenticación, verifica la firma de los tokens por su cuenta.
JWT_SECRET=ferrepega-clave-de-desarrollo-cambiar-antes-del-despliegue-0123456789
JWT_ALGORITHM=HS256
