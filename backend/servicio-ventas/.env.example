# Copia este archivo como ".env" y ajusta los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Conexión a la base de datos de este microservicio
DATABASE_URL=postgresql+psycopg2://ventas_user:Ferre_ventas_2025@localhost:5432/ventas_db

# Debe ser EXACTAMENTE la misma clave que usa servicio-autenticacion.
JWT_SECRET=ferrepega-clave-de-desarrollo-cambiar-antes-del-despliegue-0123456789
JWT_ALGORITHM=HS256

# Dirección de servicio-inventario (este servicio le pide precios y stock por HTTP).
# Más adelante, en el despliegue, seguirá siendo local a la VM del back.
INVENTARIO_URL=http://127.0.0.1:8002
INVENTARIO_TIMEOUT=5
